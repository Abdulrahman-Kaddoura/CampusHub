# Backend used by Vite dev server proxy for requests to /api
# Default in vite.config.js is http://localhost:9090
VITE_BACKEND_URL=http://localhost:9090

# Optional API base URL for frontend fetch calls.
# Leave empty to use relative '/api/*' paths (recommended with Vite proxy in local dev).
# Example: https://api.your-domain.com
VITE_API_BASE_URL=

# Optional static bearer token used as fallback when no user token is passed/stored.
# Useful for local testing only.
VITE_API_TOKEN=

# Optional base path when frontend is served from a subdirectory.
# Leave empty for local development at root (/).
# Example: /campus-hub/
VITE_BASE_PATH=
